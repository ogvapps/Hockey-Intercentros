rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the super-admin (Google auth)
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'orestesgvillanueva@gmail.com';
    }

    // Helper: any authenticated user (Google or anonymous via PIN)
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Tournaments ──
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /matches/{matchId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }

      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // (Keep legacy matches/teams for backwards compat during migration)
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── App settings: anyone reads, only super-admin writes ──
    match /app/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Admins collection: only super-admin ──
    match /admins/{uid} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ── Stats / visits: anyone can increment, only super-admin reads ──
    match /stats/visits {
      allow read: if isSuperAdmin();
      allow update, create: if true;
    }

    // ── Presence: anyone writes their own, only super-admin reads all ──
    match /presence/{sessionId} {
      allow read: if isSuperAdmin();
      allow write: if true;
    }
  }
}
